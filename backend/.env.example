# Copia este archivo como .env (en esta misma carpeta) y pon tus claves.
# .env NUNCA se sube al repo: ya está en .gitignore.

# Orden en que se le pregunta a cada IA: si la primera falla, contesta la siguiente.
# Groq va primero mientras la clave de Gemini siga con 403 "project denied access".
# Cuando Gemini funcione, cámbialo a: gemini,groq
IA_ORDEN=groq,gemini

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Peticiones por día del plan gratuito de cada proveedor (0 = sin límite conocido).
# Avisa en el log al 80% y al 100% se salta al respaldo.
# Gemini: revisa el número real de tu modelo en https://aistudio.google.com/rate-limit
GEMINI_LIMITE_DIARIO=250
# Groq, openai/gpt-oss-20b gratuito: 1,000 al día
GROQ_LIMITE_DIARIO=1000

# Visión (/ver: billetes y escenas). Gemini usa el mismo GEMINI_MODEL.
# GROQ_MODEL es solo texto, así que Groq usa otro modelo para las fotos:
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Límite diario de ese modelo (0 = sin límite conocido). Revisa el número real en
# https://console.groq.com/settings/limits
GROQ_VISION_LIMITE_DIARIO=0
# Tokens máximos de cada respuesta de visión. El plan gratis de Groq deja 1,000 por minuto
# en qwen/qwen3.8-27b: con 150 caben unas 6 fotos por minuto.
VISION_MAX_TOKENS=150

# Segundos máximos que se espera a cada proveedor antes de pasar al siguiente
IA_TIEMPO_LIMITE_S=20

# --- Seguridad (para cuando el servidor esté en internet) ---
# Clave que la app debe mandar en el encabezado X-Clave-App. Vacía = no se pide
# (así funciona la app de hoy). Pon una larga y al azar antes de publicar el servidor.
CECAPI_CLAVE_APP=
# Peticiones por minuto que puede hacer cada dirección IP (0 = sin límite).
LIMITE_POR_MINUTO=20

# --- Base de datos ---
# Archivo SQLite donde se guardan las conversaciones y el uso diario. Vacío = backend/cecapi.db
CECAPI_BD=
# 1 = guardar lo que dijo la persona y lo que contestó la IA. 0 = no (texto en NULL y
# conversaciones sin título; el panel funciona igual). Se queda en 0 hasta que Pp autorice
# datos reales (decisión 0005). Lo bloqueado por privacidad nunca se guarda.
GUARDAR_TEXTOS=0
