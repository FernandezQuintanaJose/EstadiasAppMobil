# Copia este archivo como .env (en esta misma carpeta) y pon tus claves.
# .env NUNCA se sube al repo: ya está en .gitignore.

# Orden en que se le pregunta a cada IA: si la primera falla, contesta la siguiente.
# Groq va primero mientras la clave de Gemini siga con 403 "project denied access".
# Cuando Gemini funcione, cámbialo a: gemini,groq
IA_ORDEN=groq,gemini

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Peticiones por día del plan gratuito de cada proveedor (0 = sin límite conocido).
# Avisa en el log al 80% y al 100% se salta al respaldo.
# Gemini: revisa el número real de tu modelo en https://aistudio.google.com/rate-limit
GEMINI_LIMITE_DIARIO=250
# Groq, revisado en la consola de la cuenta (console.groq.com/settings/limits) el 30/10/2026:
# openai/gpt-oss-20b da 30 peticiones por minuto, 1,000 al día, 8,000 tokens por minuto y
# 200,000 tokens al día. Se acaban antes los TOKENS: cada pregunta gasta unos 700 a 900
# (530 de INSTRUCCIONES + pregunta + razonamiento de gpt-oss + respuesta), así que el día
# alcanza para unas 220 a 280 preguntas, y el minuto para unas 10. Por eso el tope es 250 y
# no 1,000. Si en /panel ves que Groq deja de contestar antes de 250, bájalo.
GROQ_LIMITE_DIARIO=250
# Temperatura de Groq (0 a 2). 0.3 reduce datos inventados; vacía = la de Groq (1).
GROQ_TEMPERATURA=0.3

# Visión (/ver: billetes y escenas). Gemini usa el mismo GEMINI_MODEL.
# GROQ_MODEL es solo texto, así que Groq usa otro modelo para las fotos:
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# qwen/qwen3.8-27b tiene los mismos números que gpt-oss-20b (consola, 30/10/2026). Una foto
# reducida a IMAGEN_LADO_MAX gasta del orden de 1,000 tokens o más; el tope de 150 es una
# estimación para no chocar con los 200,000 tokens del día. Ajústalo con lo que veas en /panel.
GROQ_VISION_LIMITE_DIARIO=150
# Tokens máximos de cada respuesta de visión. Respuestas cortas = más fotos dentro de los
# 8,000 tokens por minuto de qwen/qwen3.8-27b.
VISION_MAX_TOKENS=150

# Segundos máximos que se espera a cada proveedor antes de pasar al siguiente
IA_TIEMPO_LIMITE_S=20

# --- Seguridad (para cuando el servidor esté en internet) ---
# Clave que la app debe mandar en el encabezado X-Clave-App. Vacía = no se pide
# (así funciona la app de hoy). Pon una larga y al azar antes de publicar el servidor.
CECAPI_CLAVE_APP=
# Peticiones por minuto que puede hacer cada dirección IP (0 = sin límite).
LIMITE_POR_MINUTO=20

# --- Base de datos ---
# Vacía = SQLite en backend/cecapi.db (para tu PC). Publicado: la cadena de Neon
# (postgresql://...?sslmode=require), solo en las variables de Render, nunca en el repo.
DATABASE_URL=
# 1 = guardar lo que dijo la persona y lo que contestó la IA. 0 = no (texto en NULL y
# conversaciones sin título; el panel funciona igual). Se queda en 0 hasta que Pp autorice
# datos reales (decisión 0005). Lo bloqueado por privacidad, el contexto y las fotos nunca se guardan.
GUARDAR_TEXTOS=0
