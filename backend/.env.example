# Copia este archivo como .env (en esta misma carpeta) y pon tus claves.
# .env NUNCA se sube al repo: ya está en .gitignore.

# Proveedor principal: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Respaldo si Gemini falla o se queda sin cuota: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Peticiones por día del plan gratuito de cada proveedor (0 = sin límite conocido).
# Avisa en el log al 80% y al 100% se salta al respaldo.
# Gemini: revisa el número real de tu modelo en https://aistudio.google.com/rate-limit
GEMINI_LIMITE_DIARIO=250
# Groq, openai/gpt-oss-20b gratuito: 1,000 al día
GROQ_LIMITE_DIARIO=1000

# Visión (/ver: billetes y escenas). Gemini usa el mismo GEMINI_MODEL.
# GROQ_MODEL es solo texto, así que Groq usa otro modelo para las fotos:
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Límite diario de ese modelo (0 = sin límite conocido). Revisa el número real en
# https://console.groq.com/settings/limits
GROQ_VISION_LIMITE_DIARIO=0
# Tokens máximos de cada respuesta de visión. El plan gratis de Groq deja 1,000 por minuto
# en qwen/qwen3.8-27b: con 150 caben unas 6 fotos por minuto.
VISION_MAX_TOKENS=150

# Segundos máximos que se espera a cada proveedor antes de pasar al siguiente
IA_TIEMPO_LIMITE_S=20
